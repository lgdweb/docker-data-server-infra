# Fallback stack — copy to `.env` next to docker-compose.yaml and fill in.
#
# Not needed on a host provisioned by Ansible: the roles already pass these
# values to the containers.

# Hostname suffix used in container names (fail2ban-<host>, arcane-manager-<host>, ...).
# Docker Compose substitutes the shell ${HOSTNAME} when this file is absent.
HOSTNAME=homelab

# Public URL of the Arcane manager, served by Nginx Proxy Manager.
APP_URL=https://arcane.example.com

PUID=1000
PGID=1000

# openssl rand -hex 32
# Never change it once the manager holds data.
ENCRYPTION_KEY=

# `arc_` + openssl rand -hex 32 (64 hex characters, prefix included).
# Any other format is rejected at startup. Safe to rotate.
ADMIN_STATIC_API_KEY=

# CIDR of the reverse proxy network; Arcane trusts it for client IP headers.
# Must match the iprange of `default-nw` (192.168.10.0/26).
TRUSTED_PROXIES=192.168.10.0/26
